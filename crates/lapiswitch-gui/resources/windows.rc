1 ICON "lapiSwitch.ico"

1 VERSIONINFO
FILEVERSION @VERSION_NUM@
PRODUCTVERSION @VERSION_NUM@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "lapiSwitch - TB520FU Region Tool\0"
            VALUE "FileVersion", "@VERSION_STRING@\0"
            VALUE "InternalName", "lapiSwitch\0"
            VALUE "OriginalFilename", "lapiSwitch.exe\0"
            VALUE "ProductName", "lapiSwitch\0"
            VALUE "ProductVersion", "@VERSION_STRING@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
